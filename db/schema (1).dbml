// Вставте у ліву панель редактора на https://dbdiagram.io/d
Project course_management { database_type: 'PostgreSQL' }

Table roles { role_id int [pk, increment]  name varchar(50) [unique, not null] }

Table users {
  user_id int [pk, increment]
  role_id int [not null, ref: > roles.role_id]
  email varchar(256) [not null]
  password_hash varchar(256) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > users.user_id]
}

Table categories {
  category_id int [pk, increment]
  parent_category_id int [ref: > categories.category_id]
  name varchar(150) [not null]
}

Table courses {
  course_id int [pk, increment]
  category_id int [not null, ref: > categories.category_id]
  title varchar(200) [not null]
  description text
  level smallint [not null, note: '1..3']
  price numeric(10,2) [not null]
  is_published boolean [not null, default: false]
  max_students int
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  created_by int [ref: > users.user_id]
  updated_at timestamptz
  updated_by int [ref: > users.user_id]
}

Table course_instructors {
  course_id int [pk, ref: > courses.course_id]
  instructor_id int [pk, ref: > users.user_id]
  is_owner boolean [not null, default: false]
}

Table modules {
  module_id int [pk, increment]
  course_id int [not null, ref: > courses.course_id]
  title varchar(200) [not null]
  order_no int [not null]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  updated_at timestamptz
  updated_by int [ref: > users.user_id]
}

Table lessons {
  lesson_id int [pk, increment]
  module_id int [not null, ref: > modules.module_id]
  title varchar(200) [not null]
  content text
  video_url varchar(500)
  duration_min int [not null, default: 0]
  order_no int [not null]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  updated_at timestamptz
  updated_by int [ref: > users.user_id]
}

Table lesson_materials {
  material_id int [pk, increment]
  lesson_id int [not null, ref: > lessons.lesson_id]
  file_name varchar(255) [not null]
  file_url varchar(500) [not null]
  uploaded_at timestamptz [not null, default: `now()`]
}

Table assignments {
  assignment_id int [pk, increment]
  lesson_id int [not null, ref: > lessons.lesson_id]
  title varchar(200) [not null]
  description text
  max_score int [not null, default: 100]
  due_date timestamptz
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  updated_at timestamptz
  updated_by int [ref: > users.user_id]
}

Table enrollments {
  enrollment_id int [pk, increment]
  course_id int [not null, ref: > courses.course_id]
  student_id int [not null, ref: > users.user_id]
  enrolled_at timestamptz [not null, default: `now()`]
  status varchar(20) [not null, default: 'Active', note: 'Active / Completed / Cancelled']
  progress_percent numeric(5,2) [not null, default: 0]
  completed_at timestamptz
  indexes { (course_id, student_id) [unique] }
}

Table lesson_progress {
  enrollment_id int [pk, ref: > enrollments.enrollment_id]
  lesson_id int [pk, ref: > lessons.lesson_id]
  completed_at timestamptz [not null, default: `now()`]
}

Table submissions {
  submission_id int [pk, increment]
  assignment_id int [not null, ref: > assignments.assignment_id]
  student_id int [not null, ref: > users.user_id]
  answer_text text
  submitted_at timestamptz [not null, default: `now()`]
  score int
  feedback varchar(1000)
  graded_by int [ref: > users.user_id]
  graded_at timestamptz
  indexes { (assignment_id, student_id) [unique] }
}

Table quizzes {
  quiz_id int [pk, increment]
  module_id int [not null, ref: > modules.module_id]
  title varchar(200) [not null]
  pass_score int [not null, default: 60]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  updated_at timestamptz
  updated_by int [ref: > users.user_id]
}

Table quiz_questions {
  question_id int [pk, increment]
  quiz_id int [not null, ref: > quizzes.quiz_id]
  question_text varchar(1000) [not null]
  points int [not null, default: 1]
}

Table quiz_options {
  option_id int [pk, increment]
  question_id int [not null, ref: > quiz_questions.question_id]
  option_text varchar(500) [not null]
  is_correct boolean [not null, default: false]
}

Table quiz_attempts {
  attempt_id int [pk, increment]
  quiz_id int [not null, ref: > quizzes.quiz_id]
  student_id int [not null, ref: > users.user_id]
  score int
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
}

Table reviews {
  review_id int [pk, increment]
  course_id int [not null, ref: > courses.course_id]
  student_id int [not null, ref: > users.user_id]
  rating smallint [not null, note: '1..5']
  comment varchar(1000)
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > users.user_id]
}

Table certificates {
  certificate_id int [pk, increment]
  enrollment_id int [unique, not null, ref: - enrollments.enrollment_id]
  code uuid [unique, not null]
  issued_at timestamptz [not null, default: `now()`]
}

Table audit_log {
  audit_id bigint [pk, increment]
  table_name varchar(128) [not null]
  record_id int [not null]
  action varchar(20) [not null]
  changed_by int [ref: > users.user_id]
  changed_at timestamptz [not null, default: `now()`]
  details varchar(1000)
}
